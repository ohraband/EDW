    <entry>
      <name>Create Target</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>drop schema if exists target cascade;

create schema target;

-- Remove conflicting tables
DROP TABLE IF EXISTS target.airlines CASCADE;
DROP TABLE IF EXISTS target.airport_freq CASCADE;
DROP TABLE IF EXISTS target.airports CASCADE;
DROP TABLE IF EXISTS target.countries CASCADE;
DROP TABLE IF EXISTS target.nav_aids CASCADE;
DROP TABLE IF EXISTS target.planes CASCADE;
DROP TABLE IF EXISTS target.regions CASCADE;
DROP TABLE IF EXISTS target.routes CASCADE;
DROP TABLE IF EXISTS target.runways CASCADE;
-- End of removing

CREATE TABLE target.airlines (
    id SERIAL NOT NULL,
    name VARCHAR(256) NOT NULL,
    alias VARCHAR(256),
    country_of_origin VARCHAR(256),
    active INTEGER NOT NULL,
    callsign VARCHAR(256),
    airline_code_iata VARCHAR(256),
    airline_code_icao VARCHAR(256)
);
ALTER TABLE target.airlines ADD CONSTRAINT pk_airlines PRIMARY KEY (id);

CREATE TABLE target.airport_freq (
    id SERIAL NOT NULL,
    airport_ref INTEGER NOT NULL,
    airport_ident VARCHAR(256) NOT NULL,
    type VARCHAR(256) NOT NULL,
    description VARCHAR(256),
    freq_mhz DOUBLE PRECISION NOT NULL
);
ALTER TABLE target.airport_freq ADD CONSTRAINT pk_airport_freq PRIMARY KEY (id);

CREATE TABLE target.airports (
    id SERIAL NOT NULL,
    name VARCHAR(256) NOT NULL,
    municipality VARCHAR(256),
    country VARCHAR(256) NOT NULL,
    iata_code VARCHAR(256),
    icao_code VARCHAR(256) NOT NULL,
    latitude DOUBLE PRECISION NOT NULL,
    longtitude DOUBLE PRECISION NOT NULL,
    elevation_ft INTEGER NOT NULL,
    gmt_time_dif DOUBLE PRECISION,
    timezone___ VARCHAR(256),
    uenaso___ VARCHAR(256)
);
ALTER TABLE target.airports ADD CONSTRAINT pk_airports PRIMARY KEY (id);

CREATE TABLE target.countries (
    id SERIAL,
    code VARCHAR(256),
    name VARCHAR(256),
    continent VARCHAR(256),
    wikipedia_link VARCHAR(256),
    keywords VARCHAR(256)
);
ALTER TABLE target.countries ADD CONSTRAINT pk_countries PRIMARY KEY (id);

CREATE TABLE target.nav_aids (
    id SERIAL,
    filename VARCHAR(256),
    ident VARCHAR(256),
    name VARCHAR(256),
    type VARCHAR(256),
    freq_khz INTEGER,
    lat_deg DOUBLE PRECISION,
    lon_deg DOUBLE PRECISION,
    elev_ft INTEGER,
    iso_country VARCHAR(256),
    dme_freq_khz INTEGER,
    dme_channel VARCHAR(256),
    dme_lat_deg DOUBLE PRECISION,
    dme_long_deg DOUBLE PRECISION,
    dme_elev_ft INTEGER,
    slaved_var_deg DOUBLE PRECISION,
    magnetic_var_deg DOUBLE PRECISION,
    usage_type VARCHAR(256),
    power VARCHAR(256),
    associated_airport VARCHAR(256)
);
ALTER TABLE target.nav_aids ADD CONSTRAINT pk_nav_aids PRIMARY KEY (id);

CREATE TABLE target.planes (
    icao_code VARCHAR(256),
    name VARCHAR(256),-- NOT NULL,
    iata_code VARCHAR(256),
	tech_key BIGSERIAL NOT NULL,
	date_from TIMESTAMP,-- NOT NULL,
	date_to TIMESTAMP,-- NOT NULL,
	version INTEGER NOT NULL
);
ALTER TABLE target.planes ADD CONSTRAINT pk_planes PRIMARY KEY (tech_key);

CREATE TABLE target.regions (
    id SERIAL NOT NULL,
    code VARCHAR(256) NOT NULL,
    local_code VARCHAR(256) NOT NULL,
    name VARCHAR(256) NOT NULL,
    continent VARCHAR(256) NOT NULL,
    iso_country VARCHAR(256) NOT NULL,
    wiki_links VARCHAR(256),
    keywords VARCHAR(256)
);
ALTER TABLE target.regions ADD CONSTRAINT pk_regions PRIMARY KEY (id);

-- Warning: Missing primary key. It is recommended to explicitly define a primary key.
CREATE TABLE target.routes (
	airine_code VARCHAR(256),    
    airline_id INTEGER,
    source_airport VARCHAR(256),
    source_airport_id INTEGER,
    dest_airport VARCHAR(256),
    dest_airport_id INTEGER,
    codeshare VARCHAR(256),
    no_stops INTEGER,
    plane VARCHAR(256),
	tech_key BIGSERIAL
);
ALTER TABLE target.routes ADD CONSTRAINT pk_routes PRIMARY KEY (tech_key);

CREATE TABLE target.runways (
    id SERIAL NOT NULL,
    airport_ref INTEGER,
    airport_ident_icao VARCHAR(256),
    length_ft INTEGER,
    width_ft INTEGER,
    surface VARCHAR(256),
    lighted INTEGER,
    closed INTEGER,
    le_ident VARCHAR(256),
    le_latitude_deg DOUBLE PRECISION,
    le_longtitude_deg DOUBLE PRECISION,
    le_elevation_ft INTEGER,
    le_heading_degt DOUBLE PRECISION,
    le_displaced_treshold_ft INTEGER,
    he_ident VARCHAR(256),
    he_latitude_deg DOUBLE PRECISION,
    he_longtitude_deg DOUBLE PRECISION,
    he_elevation_ft INTEGER,
    he_heading_degt DOUBLE PRECISION,
    he_displaced_treshold_ft INTEGER
);
ALTER TABLE target.runways ADD CONSTRAINT pk_runways PRIMARY KEY (id);</sql>
