    <entry>
      <name>Create Stage</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>drop schema if exists staging cascade;

create schema staging;

CREATE TABLE staging.airlines
(
 id BIGINT,
 "name" VARCHAR(256),
 "alias" VARCHAR(256),
 airline_code_iata VARCHAR(10),
 airline_code_icao VARCHAR(10),
 callsign VARCHAR(50), 
 country_of_origin VARCHAR(256),
 active BOOLEAN
);

CREATE TABLE staging.airports
(
 id BIGINT,
 "name" VARCHAR(65),
 municipality VARCHAR(33),
 country VARCHAR(32),
 iata_code VARCHAR(3),
 icao_code VARCHAR(4),
 latitude NUMERIC(38, 18),
 longtitude NUMERIC(39, 18),
 elevation_ft  BIGINT,
 gmt_time_dif VARCHAR(5),
 timezone___ VARCHAR(2),
 uenaso___ VARCHAR(30),
 column13 VARCHAR(7),
 column14 VARCHAR(11)
);

CREATE TABLE staging.airport_freq
(
 id BIGINT,
 airport_ref BIGINT,
 airport_ident VARCHAR(7),
 "type" VARCHAR(16),
 description VARCHAR(64),
 frequency_mhz NUMERIC(10, 3)
);

CREATE TABLE staging.planes
(
 "name" VARCHAR(256),
 iata_code VARCHAR(3),
 icao_code VARCHAR(4),
 date DATE
);

CREATE TABLE staging.routes
(
 airline_code VARCHAR(10),
 airline_id VARCHAR(10),
 source_airport_code VARCHAR(10),
 source_airport_id VARCHAR(10),
 dest_airport_code VARCHAR(10),
 dest_airport_id VARCHAR(10),
 codeshare BOOLEAN,
 no_stops BIGINT,
 plane VARCHAR(256)
);

CREATE TABLE staging.runways
(
 id BIGINT,
 airport_ref BIGINT,
 airport_ident VARCHAR(7),
 length_ft BIGINT,
 width_ft BIGINT,
 surface VARCHAR(63),
 lighted BIGINT,
 closed BIGINT,
 le_ident VARCHAR(7),
 le_latitude_deg NUMERIC(15, 6),
 le_longitude_deg NUMERIC(15, 6),
 le_elevation_ft BIGINT,
 le_heading_degT NUMERIC(9, 2),
 le_displaced_threshold_ft BIGINT,
 he_ident VARCHAR(8),
 he_latitude_deg NUMERIC(15, 6),
 he_longitude_deg NUMERIC(15, 6),
 he_elevation_ft BIGINT,
 he_heading_degT NUMERIC(8, 2),
 he_displaced_threshold_ft BIGINT
);

CREATE TABLE staging.regions
(
 id BIGINT,
 code VARCHAR(7),
 local_code VARCHAR(4),
 "name" VARCHAR(51),
 continent VARCHAR(2),
 iso_country VARCHAR(2),
 wikipedia_link VARCHAR(80),
 keywords VARCHAR(93)
);

CREATE TABLE staging.nav_aids
(
 id BIGINT,
 filename VARCHAR(40),
 ident VARCHAR(8),
 "name" VARCHAR(31),
 "type" VARCHAR(7),
 frequency_khz BIGINT,
 latitude_deg NUMERIC(39, 18),
 longitude_deg NUMERIC(39, 18),
 elevation_ft BIGINT,
 iso_country VARCHAR(2),
 dme_frequency_khz BIGINT,
 dme_channel VARCHAR(4),
 dme_latitude_deg NUMERIC(13, 5),
 dme_longitude_deg NUMERIC(15, 6),
 dme_elevation_ft BIGINT,
 slaved_variation_deg NUMERIC(11, 3),
 magnetic_variation_deg NUMERIC(11, 3),
 usageType VARCHAR(8),
 "power" VARCHAR(7),
 associated_airport VARCHAR(7)
);

CREATE TABLE staging.countries
(
 id BIGINT,
 code VARCHAR(2),
 "name" VARCHAR(44),
 continent VARCHAR(2),
 wikipedia_link VARCHAR(73),
 keywords VARCHAR(51)
);</sql>
